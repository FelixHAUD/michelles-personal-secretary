# Google Gemini API key (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# Path to Google OAuth credentials JSON (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Your home address (used for travel time context in reminders)
HOME_ADDRESS=123 Main St, City, State ZIP

# Your phone number and email (for receiving reminders)
PHONE_NUMBER=+15551234567
EMAIL=you@example.com

# Twilio SMS delivery (optional — plugin auto-skips if not set)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15559876543

# SendGrid email delivery (optional — plugin auto-skips if not set)
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=secretary@example.com

# Google Maps drive time (optional — plugin auto-skips if not set)
GOOGLE_MAPS_API_KEY=AIza...

# Schedule (optional — defaults to 6 AM daily, America/Los_Angeles)
SCHEDULE_CRON=0 6 * * *
TIMEZONE=America/Los_Angeles

# Canvas LMS (optional — plugin auto-skips if not set)
CANVAS_API_TOKEN=...
CANVAS_BASE_URL=https://canvas.university.edu
